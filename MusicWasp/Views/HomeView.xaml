<UserControl x:Class="MusicWasp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock Text="{Binding WelcomeMessage}" 
                   FontSize="32" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- Shown ONLY when not logged in -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Content="Login" Command="{Binding NavigateCommand}" 
                    CommandParameter="Login" Width="200" Margin="5"/>
            <Button Content="Create Account" Command="{Binding NavigateCommand}" 
                    CommandParameter="CreateAccount" Width="200" Margin="5"/>
        </StackPanel>

        <!-- Shown ONLY when logged in as admin -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Admin Tools" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
            <Button Content="Manage Users" Width="200" Margin="5"/>
            <Button Content="Manage Songs" Width="200" Margin="5"/>
        </StackPanel>

        <!-- Shown when logged in (both user and admin) -->
        <Button Content="Settings" 
                Command="{Binding NavigateCommand}" CommandParameter="Settings" 
                Width="200" Margin="5">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Content="Logout" Command="{Binding LogoutCommand}" Width="200" Margin="5">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </StackPanel>
</UserControl>
    
