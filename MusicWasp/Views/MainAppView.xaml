<UserControl x:Class="MusicWasp.Views.MainAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid>
        <!-- 3 rows: top bar, main content, bottom bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP BAR ============ -->
        <Grid Grid.Row="0" Background="#5FD3C2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search bar centered -->
            <TextBox Grid.Column="1" 
                     Width="400" Height="25"
                     VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="White"
                     BorderThickness="0"
                     Padding="8,3"/>

            <!-- Top-right buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" 
                        VerticalAlignment="Center" Margin="0,0,15,0">
                <Button Content="⚙" FontSize="20" 
                        Width="35" Height="35" Margin="5,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Settings"
                        ToolTip="Settings"/>
                <Button Content="{Binding Username}" 
                        Padding="10,3" Margin="5,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="White"
                        Foreground="White"
                        Command="{Binding LogoutCommand}"
                        ToolTip="Click to logout"/>
            </StackPanel>
        </Grid>

        <!-- ============ MIDDLE CONTENT ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Saved Explorer -->
            <Border Grid.Column="0" Background="#252525" Padding="10">
                <StackPanel>
                    <TextBlock Text="Saved Explorer (User):" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"/>
                    <ItemsControl ItemsSource="{Binding SavedAlbums}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Width="60" Height="60" Background="#A8D8A0"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"/>
                                        <Border Width="80" Height="6" 
                                                Background="#555" Margin="0,4,0,0"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Center: Dynamic Screen -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="DYNAMIC SCREEN" 
                               FontSize="28" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Display info on artist / album highlighted" 
                               Foreground="#999" 
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Result from search" 
                               Foreground="#999" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Browsing playlist" 
                               Foreground="#999" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Right: Now Playing Queue -->
            <Border Grid.Column="2" Background="#252525" Padding="10">
                <StackPanel>
                    <TextBlock Text="\\Now playing:" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding NowPlayingQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Background="#5FD3C2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" 
                                               Foreground="White" Padding="6,3" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="00:00" 
                                               Foreground="White" Padding="6,3" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ BOTTOM BAR (Player) ============ -->
        <Grid Grid.Row="2" Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Playback controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                        VerticalAlignment="Center" Margin="15,0">
                <Button Content="⏮" FontSize="18" Width="35" Height="35" Margin="3"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Command="{Binding PreviousCommand}"/>
                <Button Content="⏯" FontSize="18" Width="35" Height="35" Margin="3"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Command="{Binding PlayPauseCommand}"/>
                <Button Content="⏭" FontSize="18" Width="35" Height="35" Margin="3"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Command="{Binding NextCommand}"/>
            </StackPanel>

            <!-- Progress bar + song title -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                <ProgressBar Height="4" 
                             Value="30" Maximum="100"
                             Background="#444" 
                             Foreground="#5FD3C2"
                             BorderThickness="0"/>
                <TextBlock Text="{Binding CurrentSongTitle}" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" FontSize="11"/>
            </StackPanel>

            <!-- Volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" 
                        VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="🔊" FontSize="16" Foreground="White" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Width="80" Minimum="0" Maximum="100" Value="60"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>