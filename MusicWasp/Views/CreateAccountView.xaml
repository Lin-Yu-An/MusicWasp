<UserControl x:Class="MusicWasp.Views.CreateAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Create Account" FontSize="24" HorizontalAlignment="Center"/>
        <TextBox Width="200" Margin="0,10"/>
        <PasswordBox Width="200" Margin="0,10"/>
        <Button Content="Create" Margin="0,10"/>
        <Button Content="Back to Login" 
                Command="{Binding NavigateCommand}" 
                CommandParameter="Login" Margin="0,5"/>
    </StackPanel>
</UserControl>