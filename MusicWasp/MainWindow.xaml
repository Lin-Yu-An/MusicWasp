<Window x:Class="MusicWasp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicWasp.ViewModels"
        xmlns:views="clr-namespace:MusicWasp.Views"
        Title="MusicWasp" Height="600" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate 
            DataType="{x:Type vm:HomeViewModel}"> 
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate 
            DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate 
            DataType="{x:Type vm:PasswordResetViewModel}">
            <views:PasswordResetView/>
        </DataTemplate>
        <DataTemplate 
            DataType="{x:Type vm:CreateAccountViewModel}">
            <views:CreateAccountView/>
        </DataTemplate>
        <DataTemplate 
            DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate 
            DataType="{x:Type vm:MainAppViewModel}">
            <views:MainAppView/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
